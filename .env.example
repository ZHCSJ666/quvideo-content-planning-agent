# Offline mode needs no credentials. Copy this file to .env for live mode.
CONTENT_API_BASE=
CONTENT_API_KEY=
CONTENT_MODEL=
# Optional: external two-line file (base URL, API key). Never commit that file.
CONTENT_API_CONFIG=
# Explicit request timeout; automatic SDK retries are disabled.
CONTENT_API_TIMEOUT=90
# Optional, only for a compatible vLLM/Qwen endpoint; leave unset for other providers.
CONTENT_VLLM_DISABLE_THINKING=
